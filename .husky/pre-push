#!/bin/sh
#
# Pre-push: the full gate, including the dogfood.
#
# `npm run check` is format + typecheck + lint + the test suite + `check:tsdoc`,
# and that last one builds the CLI and runs it against this repo's own source.
# So a push cannot introduce a comment the tool itself would reject — which has
# happened, and is the failure this hook exists to stop locally instead of ten
# minutes later in CI across nine matrix jobs.
#
# Output goes through `printf`, not `echo`. Whether `echo` expands a backslash
# escape is implementation-defined in POSIX — it happens to work in the shells
# we tested, and `printf` is specified.
#

CYAN='\033[0;36m'
RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

printf '\n'
printf '%b🔍 Running the full gate before pushing (typecheck · lint · tests · dogfood)…%b\n' \
    "$CYAN" "$NC"
printf '\n'

if ! npm run check; then
    printf '\n'
    printf '%b🚫 PUSH BLOCKED — the gate failed.%b\n' "$RED" "$NC"
    printf '\n'
    printf '%bFix it, or push once with:%b\n' "$CYAN" "$NC"
    printf '   %bgit push --no-verify%b\n' "$GREEN" "$NC"
    printf '\n'
    exit 1
fi

printf '\n'
printf '%b✅ Gate clean — pushing.%b\n' "$GREEN" "$NC"
printf '\n'
