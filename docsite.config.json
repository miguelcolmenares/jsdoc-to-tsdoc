{
  "schemaVersion": 1,
  "site": {
    "installCommand": "npx jsdoc-to-tsdoc <command>"
  },
  "adapter": "markdown-catalog",
  "visibility": "public",
  "deploy": {
    "target": "github-pages"
  },
  "anonymize": {
    "excludePaths": ["AGENTS.md"]
  },
  "options": {
    "collections": [
      {
        "id": "docs",
        "label": "Docs",
        "singular": "document",
        "source": {
          "dir": "docs",
          "layout": "files",
          "suffix": ".md"
        }
      },
      {
        "id": "examples",
        "label": "Examples",
        "singular": "example",
        "source": {
          "dir": "docs/examples",
          "layout": "files",
          "suffix": ".md"
        }
      },
      {
        "id": "tutorials",
        "label": "Tutorials",
        "singular": "tutorial",
        "source": {
          "dir": "docs/tutorials",
          "layout": "files",
          "suffix": ".md"
        }
      }
    ]
  }
}
